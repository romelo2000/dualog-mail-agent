# ---- Dualog IMAP (источник) ----
# Возьми эти значения из настроек аккаунта Dualog в Thunderbird:
# Аккаунты -> Настройки учётной записи -> Сервер входящей почты
# Пример ниже — типичная конфигурация Dualog во внутренней судовой сети
# (локальный IP, порт 143 без SSL, т.к. трафик не покидает LAN).
DUALOG_IMAP_HOST=192.168.2.254
DUALOG_IMAP_PORT=143
DUALOG_IMAP_USER=user@yourship.dualog.com
DUALOG_IMAP_PASSWORD=changeme
DUALOG_IMAP_FOLDER=INBOX
DUALOG_IMAP_USE_SSL=false

# ---- Gmail SMTP (назначение) ----
# Нужен НЕ обычный пароль от Gmail, а "пароль приложения" (App Password):
# https://myaccount.google.com/apppasswords (требует включённой 2FA)
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=465
GMAIL_SMTP_USER=youraccount@gmail.com
GMAIL_SMTP_APP_PASSWORD=changeme
GMAIL_FORWARD_TO=youraccount@gmail.com

# ---- Поведение агента ----
POLL_INTERVAL_SECONDS=300
IMAP_TIMEOUT_SECONDS=25
SMTP_TIMEOUT_SECONDS=60
MAX_RETRIES=3
RETRY_DELAY_SECONDS=2
CYCLE_WATCHDOG_SECONDS=120
STATE_FILE=state/seen_uids.json
LOG_FILE=logs/agent.log

# Максимальный размер ОДНОГО вложения, которое будет переслано (в МБ).
# Вложения крупнее лимита пропускаются (письмо всё равно пересылается, но без
# этого файла) — защита от зависания на медленном спутниковом канале и от
# превышения CYCLE_WATCHDOG_SECONDS. Если спутниковый интернет быстрый —
# можно увеличить это значение и SMTP_TIMEOUT_SECONDS/CYCLE_WATCHDOG_SECONDS.
MAX_ATTACHMENT_SIZE_MB=10
